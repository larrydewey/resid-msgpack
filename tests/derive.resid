// derive.resid — instances generated by resid-derive, run over CBOR. The
// point is not the derive itself (resid-serial tests that) but that the
// generated code needs nothing from a format beyond the protocol, so the
// same instances work here.

import "../src/msgpack.resid";
import "model_serial.resid";
import "check.resid";

Str cfg_text(Config c) { Result(Str, SerialError) r = to_msgpack_hex(c); return hex_text_of(r); }

Str config_err(Result(Config, SerialError) r) {
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(c) = r) { return f"{c.host_name}/{c.login_count}"; }
    return "unreachable";
}

Str config_text(Str hex) {
    Result(Config, SerialError) r = from_msgpack_hex(hex);
    return config_err(r);
}

Str event_text(Str hex) {
    Result(Event, SerialError) r = from_msgpack_hex(hex);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(ev) = r) { return show_event(ev); }
    return "unreachable";
}

Str show_event(Event ev) {
    Event e = ev;
    return match e {
        Started(c) => f"Started({c.host_name})",
        Stopped => "Stopped"
    };
}

Str meters_text(Str hex) {
    Result(Meters, SerialError) r = from_msgpack_hex(hex);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(m) = r) { return f"{m.value}"; }
    return "unreachable";
}

Str loose_text(Str hex) {
    Result(Loose, SerialError) r = from_msgpack_hex(hex);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(l) = r) { return match l { Num(n) => f"Num({n})", Word(s) => f"Word({s})", Nothing => "Nothing" }; }
    return "unreachable";
}

Int main() {
    Option(Str) some_mail = Some("a@b");
    Config c = Config {.host_name = "example.com", .login_count = 3, .email = some_mail, .secret = "hunter2"};

    // rename_all camelCase, rename, skip, and the field order as written.
    // Written as the map CBOR makes of a record: a2, the fields in order,
    // each name as a text key.
    check_text("config/hex", cfg_text(c), "de0003d908686f73746e616d65d90b6578616d706c652e636f6dd90a6c6f67696e436f756e7403d905656d61696cd903614062");

    // Round trip, and the alias on decode.
    check_text("config/back", config_text(cfg_text(c)), "example.com/3");
    check_text("config/alias", config_text("de0003d906736572766572d90b6578616d706c652e636f6dd90a6c6f67696e436f756e7403d905656d61696cd903614062"), "example.com/3");

    // An absent Option field decodes as None; a default fills in.
    check_text("config/minimal", config_text("de0002d908686f73746e616d65d90b6578616d706c652e636f6dd90a6c6f67696e436f756e7400"), "example.com/0");

    // skip_encoding_if drops the field entirely.
    Option(Str) no_mail = None;
    Config bare = Config {.host_name = "h", .login_count = 1, .email = no_mail, .secret = "s"};
    check_text("config/skipped", cfg_text(bare), "de0002d908686f73746e616d65d90168d90a6c6f67696e436f756e7401");

    // deny_unknown_fields.
    Result(Config, SerialError) unknown = from_msgpack_hex("de0003d908686f73746e616d65d90b6578616d706c652e636f6dd90a6c6f67696e436f756e7403d9037a7a7a01");
    check_text("config/deny unknown", config_err(unknown), "decode: unknown field `zzz`, expected `hostname`, `server`, `loginCount` or `email`");

    // An internally tagged enum: {"kind": "Started", ...}.
    check_text("event/started", hex_text_of(to_msgpack_hex(Started(bare))), "de0003d9046b696e64d90773746172746564d908686f73746e616d65d90168d90a6c6f67696e436f756e7401");
    check_text("event/stopped", hex_text_of(to_msgpack_hex(Stopped)), "de0001d9046b696e64d90773746f70706564");
    check_text("event/back", event_text("de0003d9046b696e64d90773746172746564d908686f73746e616d65d90168d90a6c6f67696e436f756e7401"), "Started(h)");
    check_text("event/unit back", event_text("de0001d9046b696e64d90773746f70706564"), "Stopped");
    check_text("event/unknown kind", event_text("de0001d9046b696e64d904636f6f70"), "decode: unknown variant `coop`, expected `started` or `stopped`");

    // transparent: one field, no wrapper.
    check_text("meters", hex_text_of(to_msgpack_hex(Meters {.value = 1.5})), "ca3fc00000");
    check_text("meters/back", meters_text("ca3fc00000"), "1.5");

    // untagged: the payload alone, tried in order.
    check_text("loose/num", loose_text("05"), "Num(5)");
    check_text("loose/word", loose_text("d904776f7264"), "Word(word)");
    check_text("loose/nothing", loose_text("c0"), "Nothing");
    check_text("loose/ambiguous", loose_text("05"), "Num(5)");

    return 0;
}