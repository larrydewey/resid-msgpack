// pack.resid — the parts of MessagePack that are not the protocol: type
// headers, the fixed-width integer forms, UTF-8 both ways and hex.
//
// A MessagePack value is one byte of type, then its payload: nothing is
// tagged with a name, so the reader knows the shape from the byte alone.
// The ints come in three widths for each sign, the two smallest folded into
// single bytes (positive 0..127, negative -32..-1), and the floats are
// 32-bit or 64-bit.

import "resid-serial/serial.resid";
import "resid-serial/seq.resid";

// ─── Type headers ────────────────────────────────────────────────────

pub Int mp_nil() { return 0xC0; }
pub Int mp_false() { return 0xC2; }
pub Int mp_true() { return 0xC3; }
pub Int mp_bin8() { return 0xC4; }
pub Int mp_bin16() { return 0xC5; }
pub Int mp_bin32() { return 0xC6; }
pub Int mp_ext8() { return 0xC7; }
pub Int mp_ext16() { return 0xC8; }
pub Int mp_ext32() { return 0xC9; }
pub Int mp_float32() { return 0xCA; }
pub Int mp_float64() { return 0xCB; }
pub Int mp_uint8() { return 0xCC; }
pub Int mp_uint16() { return 0xCD; }
pub Int mp_uint32() { return 0xCE; }
pub Int mp_uint64() { return 0xCF; }
pub Int mp_int8() { return 0xD0; }
pub Int mp_int16() { return 0xD1; }
pub Int mp_int32() { return 0xD2; }
pub Int mp_int64() { return 0xD3; }
pub Int mp_fixext1() { return 0xD4; }
pub Int mp_fixext2() { return 0xD5; }
pub Int mp_fixext4() { return 0xD6; }
pub Int mp_fixext8() { return 0xD7; }
pub Int mp_fixext16() { return 0xD8; }
pub Int mp_str8() { return 0xD9; }
pub Int mp_str16() { return 0xDA; }
pub Int mp_str32() { return 0xDB; }
pub Int mp_array16() { return 0xDC; }
pub Int mp_array32() { return 0xDD; }
pub Int mp_map16() { return 0xDE; }
pub Int mp_map32() { return 0xDF; }

// One byte of payload, big-endian: the width is what the type says.
pub List(Int) mp_int1(Int v) { return [v & 255]; }

pub List(Int) mp_int2(Int v) { return [(v >> 8) & 255, v & 255]; }

pub List(Int) mp_int4(Int v) { return mp_int_bytes(v, 4, 0, []); }

// A signed value as `n` big-endian bytes, two's complement: an arithmetic
// shift right fills with ones, so each byte is the low eight of the rest.
pub List(Int) mp_int_bytes(Int v, Int n, Int i, List(Int) acc) {
    if (i >= n) { return acc; }
    Int shift = 8 * (n - 1 - i);
    return mp_int_bytes(v, n, i + 1, acc.concat([(v >> shift) & 255]));
}

pub List(Int) mp_u4(UInt(64) v) { return mp_u4_at(v, 4, []); }

pub List(Int) mp_u4_at(UInt(64) v, Int n, List(Int) acc) {
    if (n <= 0) { return mp_rev(acc, 0, []); }
    return mp_u4_at(v / u64(256), n - 1, acc.concat([(Int)(v & 255)]));
}

pub List(Int) mp_u8(UInt(64) v) { return mp_u8_at(v, 8, []); }

pub List(Int) mp_u8_at(UInt(64) v, Int n, List(Int) acc) {
    if (n <= 0) { return mp_rev(acc, 0, []); }
    return mp_u8_at(v / u64(256), n - 1, acc.concat([(Int)(v & 255)]));
}

pub List(Int) mp_rev(List(Int) xs, Int i, List(Int) acc) {
    if (i >= xs.len()) { return acc; }
    return mp_rev(xs, i + 1, [xs[i]].concat(acc));
}

// The width an argument takes: what fits in one byte, then two, four,
// eight.
pub Int mp_width(Int n) {
    if (n < 256) { return 1; }
    if (n < 65536) { return 2; }
    if (n < 4294967296 || n < 0) { return 4; }
    return 8;
}

pub Int mp_width_tag(Int n) {
    if (n < 256) { return 1; }
    if (n < 65536) { return 2; }
    if (n < 4294967296 || n < 0) { return 4; }
    return 8;
}

// The header byte for a length of `n`, given the smallest of `one`, `two`,
// `four` and `eight` (or the fixed forms the caller passes in).
pub List(Int) mp_len_header(Int n, Int one, Int two, Int four, Int eight) {
    Int w = if (n < 256) { 1 } else { if (n < 65536) { 2 } else { if (n < 4294967296) { 4 } else { 8 } } };
    if (w == 1) { return mp_int1(one).concat(mp_int1(n)); }
    if (w == 2) { return mp_int1(two).concat(mp_int2(n)); }
    if (w == 4) { return mp_int1(four).concat(mp_u4((UInt(64))n)); }
    return mp_int1(eight).concat(mp_u8((UInt(64))n));
}

// ─── UTF-8 ───────────────────────────────────────────────────────────

pub List(Int) mp_cp_bytes(Int cp) {
    Int w = utf8_width(cp);
    if (w == 1) { return [cp]; }
    if (w == 2) { return [192 + (cp >> 6), 128 + (cp & 63)]; }
    if (w == 3) { return [224 + (cp >> 12), 128 + ((cp >> 6) & 63), 128 + (cp & 63)]; }
    return [240 + (cp >> 18), 128 + ((cp >> 12) & 63), 128 + ((cp >> 6) & 63), 128 + (cp & 63)];
}

pub List(Int) mp_str_bytes(Str s) { return mp_str_bytes_at(s, 0, []); }

pub List(Int) mp_str_bytes_at(Str s, Int i, List(Int) acc) {
    if (i >= str_len(s)) { return acc; }
    return mp_str_bytes_at(s, i + 1, acc.concat(mp_cp_bytes(str_char_at(s, i))));
}

type MpCp = { Int cp; Int next; };

pub Result(MpCp, SerialError) mp_cp_at(List(Int) bs, Int i, Str what) {
    if (i >= bs.len()) { return Err(eof_error(what)); }
    Int b0 = bs[i];
    if (b0 < 128) { return Ok(MpCp {.cp = b0, .next = i + 1}); }
    if (b0 < 192) { return Err(syntax_error(f"invalid UTF-8 in {what}: a continuation byte starts it")); }
    Int extra = if (b0 < 224) { 1 } else { if (b0 < 240) { 2 } else { 3 } };
    if (i + extra >= bs.len()) { return Err(eof_error(what)); }
    Int head = if (extra == 1) { b0 - 192 } else { if (extra == 2) { b0 - 224 } else { b0 - 240 } };
    return mp_cp_cont(bs, i, extra, 0, head, what);
}

pub Result(MpCp, SerialError) mp_cp_cont(List(Int) bs, Int i, Int extra, Int k, Int cp, Str what) {
    if (k >= extra) { return Ok(MpCp {.cp = cp, .next = i + 1 + extra}); }
    Int b = bs[i + 1 + k];
    if (b < 128 || b > 191) { return Err(syntax_error(f"invalid UTF-8 in {what}")); }
    return mp_cp_cont(bs, i, extra, k + 1, (cp << 6) | (b & 63), what);
}

pub Result(Str, SerialError) mp_str_at(List(Int) bs, Int i, Int end, Str what) { return mp_str_at_buf(bs, i, end, StrBuf(), what); }

pub Result(Str, SerialError) mp_str_at_buf(List(Int) bs, Int i, Int end, StrBuf b, Str what) {
    if (i >= end) { return Ok(b.finish()); }
    Result(MpCp, SerialError) r = mp_cp_at(bs, i, what);
    if (Err(e) = r) { Str dropped = b.finish(); return Err(e); }
    if (Ok(c) = r) { return mp_str_at_buf(bs, c.next, end, b.push_char(c.cp), what); }
    Str dropped2 = b.finish();
    return Err(custom_error("unreachable"));
}

pub Result(Int, SerialError) mp_cp_count(List(Int) bs, Int i, Int end, Str what) { return mp_cp_count_at(bs, i, end, 0, what); }

pub Result(Int, SerialError) mp_cp_count_at(List(Int) bs, Int i, Int end, Int acc, Str what) {
    if (i >= end) { return Ok(acc); }
    Result(MpCp, SerialError) r = mp_cp_at(bs, i, what);
    if (Err(e) = r) { return Err(e); }
    if (Ok(c) = r) { return mp_cp_count_at(bs, c.next, end, acc + 1, what); }
    return Err(custom_error("unreachable"));
}

// ─── Floats ──────────────────────────────────────────────────────────
//
// Resid has no float-to-bits builtin, so the bit patterns are built from the
// value's own arithmetic: scale into [1, 2) for the exponent field and
// shift the fraction out a bit at a time, which is exact for a value that is
// already a binary floating-point number.

pub Float mp_pow2(Int n) {
    if (n >= 0) { return mp_pow2_up(n, 1.0); }
    return mp_pow2_down(0 - n, 1.0);
}

pub Float mp_pow2_up(Int n, Float acc) {
    if (n == 0) { return acc; }
    return mp_pow2_up(n - 1, acc * 2.0);
}

pub Float mp_pow2_down(Int n, Float acc) {
    if (n == 0) { return acc; }
    return mp_pow2_down(n - 1, acc / 2.0);
}

pub Bool mp_is_nan(Float v) { return v != v; }

pub Bool mp_is_inf(Float v) { return !mp_is_nan(v) && v > 0.0 && v / 2.0 == v; }

// The unbiased exponent: a = m × 2^e with 1 <= m < 2.
pub Int mp_exp(Float a) {
    if (a >= 1.0) { return mp_exp_up(a, 0); }
    return mp_exp_down(a, 0);
}

pub Int mp_exp_up(Float x, Int e) {
    if (x < 2.0) { return e; }
    return mp_exp_up(x / 2.0, e + 1);
}

pub Int mp_exp_down(Float x, Int e) {
    if (x >= 1.0) { return e; }
    return mp_exp_down(x * 2.0, e - 1);
}

pub UInt(64) mp_frac_bits(Float m, Int width) { return mp_frac_at(m, width, u64(0)); }

pub UInt(64) mp_frac_at(Float m, Int left, UInt(64) acc) {
    if (left <= 0) { return acc; }
    Float x = m * 2.0;
    if (x >= 1.0) { return mp_frac_at(x - 1.0, left - 1, acc * u64(2) + u64(1)); }
    return mp_frac_at(x, left - 1, acc * u64(2));
}

// The sign bit: `v < 0.0` alone misses negative zero, which the
// reciprocal gives away.
pub Bool mp_is_neg(Float v) { return v < 0.0 || (v == 0.0 && 1.0 / v < 0.0); }

pub List(Int) mp_f64_bits(Float v) {
    Float a = if (mp_is_neg(v)) { 0.0 - v } else { v };
    if (a == 0.0) { return mp_u8(mp_sign_bits(mp_is_neg(v))); }
    Int e = mp_exp(a);
    UInt(64) raw = ((UInt(64))(e + 1023) << 52) | mp_frac_bits(a / mp_pow2(e) - 1.0, 52);
    return mp_u8(raw | mp_sign_bits(mp_is_neg(v)));
}

pub UInt(64) mp_sign_bits(Bool neg) { return if (neg) { u64(0x8000000000000000) } else { u64(0) }; }

pub Float mp_f64_from(List(Int) bs, Int i) {
    Float sign = if (bs[i] >= 128) { -1.0 } else { 1.0 };
    Int e = ((bs[i] & 0x7F) << 4) | (bs[i + 1] >> 4);
    Int m = ((bs[i + 1] & 0x0F) << 48) | (bs[i + 2] << 40) | (bs[i + 3] << 32) | (bs[i + 4] << 24) | (bs[i + 5] << 16) | (bs[i + 6] << 8) | bs[i + 7];
    if (e == 0) { return sign * (Float)m * mp_pow2(0 - 1074); }
    if (e == 2047) { return if (m == 0) { mp_inf(sign) } else { mp_nan() }; }
    return sign * (1.0 + (Float)m * mp_pow2(0 - 52)) * mp_pow2(e - 1023);
}

pub List(Int) mp_f32_bits(Float(32) v) {
    Float wide = (Float)v;
    Float a = if (mp_is_neg(wide)) { 0.0 - wide } else { wide };
    if (a == 0.0) { return [if (mp_is_neg(wide)) { 128 } else { 0 }, 0, 0, 0]; }
    Int e = mp_exp(a);
    UInt(64) mant = mp_frac_bits(a / mp_pow2(e) - 1.0, 23);
    Int ex = e + 127;
    Int hi = (ex >> 1) | (if (mp_is_neg(wide)) { 128 } else { 0 });
    return [hi, ((ex & 1) << 7) | ((Int)(mant >> 16) & 0x7F), (Int)((mant >> 8) & 0xFF), (Int)(mant & 0xFF)];
}

pub Float mp_f32_from(List(Int) bs, Int i) {
    Float sign = if (bs[i] >= 128) { -1.0 } else { 1.0 };
    Int e = ((bs[i] & 0x7F) << 1) | (bs[i + 1] >> 7);
    Int m = ((bs[i + 1] & 0x7F) << 16) | (bs[i + 2] << 8) | bs[i + 3];
    if (e == 0) { return sign * (Float)m * mp_pow2(0 - 149); }
    if (e == 255) { return if (m == 0) { mp_inf(sign) } else { mp_nan() }; }
    return sign * (1.0 + (Float)m * mp_pow2(0 - 23)) * mp_pow2(e - 127);
}

pub Float mp_inf(Float sign) { Float z = 0.0; return sign * (1.0 / z); }

pub Float mp_nan() { Float z = 0.0; return z / z; }

// Single when the value survives the narrowing, else double.
pub Bool mp_fits_f32(Float v) { return (Float)f32(v) == v; }

// ─── Hex ─────────────────────────────────────────────────────────────

pub Str mp_hex(List(Int) bs) { return mp_hex_at(bs, 0, StrBuf()); }

// The hex text, two digits per byte, gathered in one builder.
pub Str mp_hex_at(List(Int) bs, Int i, StrBuf b) {
    if (i >= bs.len()) { return b.finish(); }
    StrBuf more = b.push(mp_hex_digit(bs[i] >> 4)).push(mp_hex_digit(bs[i] & 15));
    return mp_hex_at(bs, i + 1, more);
}

pub Str mp_hex_digit(Int n) { return str_slice("0123456789abcdef", n, n + 1); }

pub Result(List(Int), SerialError) mp_unhex(Str h) { return mp_unhex_at(h, 0, ListBuf()); }

pub Result(List(Int), SerialError) mp_unhex_at(Str h, Int i, ListBuf(Int) b) {
    if (i >= str_len(h)) { return Ok(b.finish()); }
    Int hi = mp_hex_nibble(h, i);
    if (hi < 0) { List(Int) dropped = b.finish(); return Err(syntax_error(f"invalid hex digit in \"{h}\"")); }
    Int lo = mp_hex_nibble(h, i + 1);
    if (lo < 0) { List(Int) dropped2 = b.finish(); return Err(syntax_error(f"invalid hex digit in \"{h}\"")); }
    return mp_unhex_at(h, i + 2, b.push(hi * 16 + lo));
}

pub Int mp_hex_nibble(Str h, Int i) {
    if (i >= str_len(h)) { return -1; }
    Int c = str_char_at(h, i);
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}